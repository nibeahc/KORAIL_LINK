# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# EIA Brent: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key

# 한국은행 ECOS 환율: https://ecos.bok.or.kr/
ECOS_API_KEY=your_ecos_api_key

# 모두싸인 전자서명: https://developers.modusign.co.kr/docs/api-%EC%86%8C%EA%B0%9C
MODUSIGN_API_KEY=your_modusign_api_key
MODUSIGN_USER_EMAIL=your_modusign_account_email

# 선택: 뉴스 API를 사용할 경우
NEWS_API_KEY=your_news_api_key
