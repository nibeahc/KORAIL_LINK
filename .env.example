# Supabase (현재 사용 중인 값은 .env.local에 유지)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Anthropic Claude API (server-side only)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4.1-mini
# 선택: OpenRouter 앱 출처 표시용 배포 URL
OPENROUTER_SITE_URL=http://localhost:3000

# EIA Brent: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key

# 한국은행 ECOS 환율: https://ecos.bok.or.kr/
ECOS_API_KEY=your_ecos_api_key

# 모두싸인 전자서명: https://developers.modusign.co.kr/docs/api-%EC%86%8C%EA%B0%9C
MODUSIGN_API_KEY=your_modusign_api_key
MODUSIGN_USER_EMAIL=your_modusign_account_email

# 선택: 뉴스 API를 사용할 경우
NEWS_API_KEY=your_news_api_key

# Naver News Search API (server-side only)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
